        {
          "resource_id": "feat",
          "stats": {
            "name": {
              "value": "Variant Feature: Leading Expert"
            },
            "prerequisites": {
              "value": ""
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "After dedicating yourself to an area of study for some time you have become a foremost authority in that field. Other scholars and students defer to your knowledge and wisdom in your chosen area, and you have access to the Cryptarchy's restricted files and equipment related to your field. You also have a friend or two in the departments of other areas of study, and should you need something you can't access yourself, they may be able to quietly provide it for you."
                    },
