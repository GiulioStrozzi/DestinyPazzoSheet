            }
          }
        },
        {
          "resource_id": "feat",
          "stats": {
            "name": {
              "value": "Mighty Blow (optional)"
            },
            "prerequisites": {
              "value": ""
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "If you do not choose to add Tusks and Gore to your Cabal character, you can choose to add Mighty Blow instead. When you roll a critical hit with a weapon attack, you can add one of the weapon's damage dice to your damage roll after accounting for the effects of the critical hit."
                    },
