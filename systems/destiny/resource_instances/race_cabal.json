                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You have advantage on saving throws you make to prevent yourself from being knocked back or knocked prone, as well as on Strength saving throws or Strength (Athletics) checks you make to prevent yourself from being grappled or shoved."
