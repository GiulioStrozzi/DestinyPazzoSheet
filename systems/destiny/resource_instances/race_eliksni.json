                          "stats": {
                            "level": {
                              "value": 1
                            },
                            "description": {
                              "value": "You are a much easier target to hit on the battlefield now, and your increased size hinders your movement. While maintaining this form, your AC is reduced by 1, and your Dexterity score is reduced by 2."
                            },
                            "id": "b4f02a59-2116-4d56-a2b3-eca749d27c73",
