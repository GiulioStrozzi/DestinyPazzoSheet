                    "descriptions": {
                      "value": [
                        {
                          "resource_id": "levelled_description",
                          "stats": {
                            "level": {
                              "value": 1
                            },
                            "description": {
                              "value": "If a creature makes a weapon attack against you, or if you are forced to make a Dexterity saving throw, you can choose to use your Blink trait as a reaction. You can only choose to do this if you did not use Blink since the start of your previous turn, and if there is an unoccupied spot within range of your Blink. When you choose to do this, you cause disadvantage on the attack roll, or you grant yourself advantage on the Dexterity saving throw."
                            },
