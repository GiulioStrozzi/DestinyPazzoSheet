        {
          "resource_id": "feat",
          "stats": {
            "name": {
              "value": "Darkvision"
            },
            "prerequisites": {
              "value": ""
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "Vex monocular sensors can be tuned to perceive various electromagnetic spectra. You can see in dim light within 30 feet of you as if it were bright light, and in darkness as if it were dim light."
                    },
                    "id": "d29c6f1e-936c-4ff2-aec9-735afc81f30d",
