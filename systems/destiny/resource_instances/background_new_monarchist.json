        },
        {
          "resource_id": "feat",
          "stats": {
            "name": {
              "value": "Variant Feature: Kingmaker"
            },
            "prerequisites": {
              "value": ""
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You have secured respected standing in the faction leadership, and are well known to the executors. You have considerable influence within the faction, effectively enabling you to command other members of lower standing, and entitling you to draw upon New Monarchy's considerable material wealth and political influence. Additionally, your favored status enables you to stand somewhat apart from the City's government and the Vanguard. You may receive information typically only available to the Consensus, and New Monarchy's leaders may offer political protection if you should run afoul of the Vanguard or other authorities."
                    },
                    "id": "7bb2dd3a-b3be-483e-af63-e74a2dbfbe7a",
