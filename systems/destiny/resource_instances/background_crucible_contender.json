        {
          "resource_id": "feat",
          "stats": {
            "name": {
              "value": "Feature: Rookie of the Year"
            },
            "prerequisites": {
              "value": ""
            },
            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You can expect other people who follow the rankings of your chosen area of competition to have heard of you. Those who have a favorable opinion of you are generally willing to provide you with free food and beverages for the chance to hang out with you for a while. You can also easily request private matches without much wait time, and should you decide to switch areas of competition, you'll generally find it easier to get in contact with mid-tier or higher competitors in your new area and possibly team up with them."
                    },
                    "id": "82a2fa0b-a070-47f1-b072-9422106f7f60",
